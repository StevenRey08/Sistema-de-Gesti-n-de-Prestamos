generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =========================================
// SEGURIDAD Y ROLES
// =========================================

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre_rol  String    @unique @db.VarChar(50)
  descripcion String?
  protegido   Boolean   @default(false)
  permisos    Permiso[]
  usuarios    Usuario[]

  @@map("roles")
}

model Modulo {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre      String    @unique @db.VarChar(100)
  descripcion String?
  permisos    Permiso[]

  @@map("modulos")
}

model Permiso {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rol_id     String? @db.Uuid
  modulo_id  String? @db.Uuid
  leer       Boolean @default(false)
  ingresar   Boolean @default(false)
  actualizar Boolean @default(false)
  eliminar   Boolean @default(false)
  modulo     Modulo? @relation(fields: [modulo_id], references: [id], onDelete: Cascade)
  rol        Role?   @relation(fields: [rol_id], references: [id], onDelete: Cascade)

  @@unique([rol_id, modulo_id])
  @@map("permisos")
}

model Usuario {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo_documento   String?      @db.VarChar(20)
  numero_documento String?      @unique @db.VarChar(50)
  nombre           String       @db.VarChar(50)
  apellido         String       @db.VarChar(50)
  usuario          String       @unique @db.VarChar(50)
  contrasena       String       @db.VarChar(255)
  email            String?      @db.VarChar(100)
  rol_id           String?      @db.Uuid
  activo           Boolean      @default(true)
  movimientos      Movimiento[]
  prestamos        Prestamo[]
  pedidos          Pedido[]     // Relación con los pedidos que realiza el usuario
  rol              Role?        @relation(fields: [rol_id], references: [id], onDelete: Restrict)

  @@index([rol_id])
  @@map("usuarios")
}

// =========================================
// LOGÍSTICA E INVENTARIO
// =========================================

model Persona {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matricula        String?      @unique @db.VarChar(50)
  nombres          String?      @db.VarChar(100)
  apellidos        String?      @db.VarChar(100)
  tipo             String?      @db.VarChar(50) // Estudiante, Profesor, etc.
  curso            String?      @db.VarChar(100) // <--- Nuevo campo para el curso
  telefono         String?      @db.VarChar(20)
  activo           Boolean      @default(true)
  movimientos             Movimiento[]
  prestamos_estudiante    Prestamo[]   @relation("EstudiantePrestamo")
  prestamos_instructor    Prestamo[]   @relation("InstructorPrestamo")

  @@map("personas")
}

model CategoriaHerramienta {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre       String       @unique @db.VarChar(100)
  descripcion  String?
  ubicacion_id String?      @db.Uuid // La categoría ahora define la ubicación
  ubicacion    Ubicacion?   @relation(fields: [ubicacion_id], references: [id])
  inventarios  Inventario[]

  @@map("categorias_herramientas")
}

model Ubicacion {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo              String                 @unique @db.VarChar(50)
  nombre              String                 @db.VarChar(100)
  tipo                String                 @db.VarChar(50)
  descripcion         String?
  ubicacion_padre_id  String?                @db.Uuid
  categorias          CategoriaHerramienta[] // Relación con categorías
  movimientos_destino Movimiento[]           @relation("UbicacionDestino")
  movimientos_origen  Movimiento[]           @relation("UbicacionOrigen")
  padre               Ubicacion?             @relation("JerarquiaUbicacion", fields: [ubicacion_padre_id], references: [id])
  sub_ubicaciones     Ubicacion[]            @relation("JerarquiaUbicacion")

  @@map("ubicaciones")
}

model Inventario {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo              String                @unique @db.VarChar(50)
  nombre              String                @db.VarChar(150)
  categoria_id        String?               @db.Uuid
  
  cantidad_total       Int                  @default(0) 
  cantidad_disponible  Int                  @default(0) 
  cantidad_danada      Int                  @default(0) 
  
  imagen_ruta         String?
  
  categoria           CategoriaHerramienta? @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  movimientos         Movimiento[]
  prestamos           Prestamo[]
  prestamos_detalles  PrestamoDetalle[]
  // Cambiado: Ahora la relación es con los detalles
  detalles_pedidos    DetallePedido[] 

  @@index([categoria_id])
  @@map("inventario")
}

// =========================================
// NUEVA TABLA: PEDIDOS (ABASTECIMIENTO)
// =========================================

model Pedido {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id    String?         @db.Uuid
  numero_orden  String?         @unique @db.VarChar(50) // Ej: COMPRA-2024-001
  fecha_pedido  DateTime        @default(now()) @db.Timestamp(6)
  fecha_entrega DateTime?       @db.Timestamp(6)
  estado        String          @default("PENDIENTE") @db.VarChar(50)
  prioridad     String?         @db.VarChar(20)
  proveedor     String?         @db.VarChar(150) // Para saber a quién se le compró
  observaciones String?         @db.Text
  
  // Relaciones
  detalles      DetallePedido[] // Un pedido tiene muchas herramientas
  usuario       Usuario?        @relation(fields: [usuario_id], references: [id])

  @@map("pedidos")
}

model DetallePedido {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pedido_id     String      @db.Uuid
  inventario_id String      @db.Uuid
  cantidad      Int         // Cuántas se pidieron
  precio_unit   Decimal?    @db.Decimal(10, 2) // Opcional: para control de costos
  
  pedido        Pedido      @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  inventario    Inventario  @relation(fields: [inventario_id], references: [id])

  @@map("detalles_pedidos")
}

// =========================================
// TRANSACCIONES
// =========================================

model Prestamo {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventario_id    String?      @db.Uuid

  // 1. Quién recibe la herramienta (Estudiante)
  persona_id       String?      @db.Uuid

  // 2. Quién autoriza/manda (Instructor/Profesor)
  instructor_id    String?      @db.Uuid

  usuario_id       String?      @db.Uuid
  cantidad         Int          @default(0)
  fecha_prestamo   DateTime?    @default(now()) @db.Timestamp(6)
  fecha_devolucion DateTime?    @db.Timestamp(6)
  estado           String?      @db.VarChar(50)
  observaciones    String?

  movimientos      Movimiento[]
  detalles         PrestamoDetalle[]

  // Relaciones
  inventario       Inventario?  @relation(fields: [inventario_id], references: [id], onDelete: Restrict)
  usuario          Usuario?     @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  // Relaciones duales con Persona (Se deben nombrar para diferenciarlas)
  persona          Persona?     @relation("EstudiantePrestamo", fields: [persona_id], references: [id], onDelete: Restrict)
  instructor       Persona?     @relation("InstructorPrestamo", fields: [instructor_id], references: [id], onDelete: Restrict)

  @@index([inventario_id])
  @@index([persona_id])
  @@index([instructor_id])
  @@index([estado])
  @@map("prestamos")
}

model PrestamoDetalle {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prestamo_id   String     @db.Uuid
  inventario_id String     @db.Uuid
  cantidad      Int

  estado_devolucion      String?  @db.VarChar(50) // PENDIENTE, BUEN_ESTADO, MAL_ESTADO, PERDIDO
  cantidad_devuelta_buena Int     @default(0)
  cantidad_devuelta_danada Int    @default(0)
  cantidad_perdida       Int     @default(0)
  observaciones_devolucion String? @db.Text

  prestamo   Prestamo   @relation(fields: [prestamo_id], references: [id], onDelete: Cascade)
  inventario Inventario @relation(fields: [inventario_id], references: [id], onDelete: Restrict)

  @@index([prestamo_id])
  @@index([inventario_id])
  @@map("prestamos_detalles")
}

model Movimiento {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventario_id        String?     @db.Uuid
  persona_id           String?     @db.Uuid
  usuario_id           String?     @db.Uuid
  prestamo_id          String?     @db.Uuid
  cantidad             Int
  tipo                 String?     @db.VarChar(50)
  fecha                DateTime?   @default(now()) @db.Timestamp(6)
  observaciones        String?
  ubicacion_destino_id String?     @db.Uuid
  ubicacion_origen_id  String?     @db.Uuid
  inventario           Inventario? @relation(fields: [inventario_id], references: [id], onDelete: Cascade)
  persona              Persona?    @relation(fields: [persona_id], references: [id])
  prestamo             Prestamo?   @relation(fields: [prestamo_id], references: [id])
  ubicacion_destino    Ubicacion?  @relation("UbicacionDestino", fields: [ubicacion_destino_id], references: [id])
  ubicacion_origen     Ubicacion?  @relation("UbicacionOrigen", fields: [ubicacion_origen_id], references: [id])
  usuario              Usuario?    @relation(fields: [usuario_id], references: [id])

  @@index([inventario_id])
  @@index([tipo])
  @@map("movimientos")
}
